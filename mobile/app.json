{
  "expo": {
    "name": "Primer Chat",
    "slug": "primer-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.primer.chat",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Primer Chat to access your microphone to make voice calls."
      }
    },
    "android": {
      "package": "com.primer.chat",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
