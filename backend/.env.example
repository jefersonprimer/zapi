# Banco Postgres local (docker compose up -d postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/primer_chat
# Produção usa Supabase: postgresql://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres

JWT_SECRET=troque-isto-em-producao

# Serviço opcional de remoção de fundo (stickers) — services/bg-remover
BG_REMOVER_URL=http://localhost:5050

# Porta do servidor HTTP/WS (default do binário: 3000; aqui usamos 3001 p/ não colidir com o Next)
PORT=3001
